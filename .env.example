# triage-agent — example environment file
#
# Copy this to .env (already gitignored) and fill in what you need. Nothing
# here is required — RulesClassifier, the default classifier, makes zero API
# calls to any vendor. These variables only matter if you use LLMClassifier /
# HybridClassifier, or run scripts/*_accuracy.py.
#
# See docs/concepts/classifiers.md's "Open by default" note: with nothing set
# at all, LLMClassifier requires an explicit model= and scripts/*_accuracy.py
# default to local Ollama (no account or key needed) — a paid key is never
# the only way to try this out.

# --- triage/classifier/llm.py: LLMClassifier / HybridClassifier -------------

# Set to use any OpenAI-compatible backend instead of Anthropic. Leave unset
# to use Anthropic (reads ANTHROPIC_API_KEY below).
#   Ollama (local, no key):  http://localhost:11434/v1
#   Ollama Cloud:            https://ollama.com/v1
#   Groq:                    https://api.groq.com/openai/v1
#   OpenAI:                  https://api.openai.com/v1
# TRIAGE_LLM_BASE_URL=

# API key for the OpenAI-compatible backend above (TRIAGE_LLM_BASE_URL). Not
# needed for local Ollama.
# TRIAGE_LLM_API_KEY=

# Required if you use LLMClassifier without passing model= explicitly.
#   Ollama:    llama3.2
#   Groq:      llama-3.1-8b-instant
#   OpenAI:    gpt-4o-mini
#   Anthropic: claude-haiku-4-5-20251001
# TRIAGE_LLM_MODEL=

# Output token budget for the classification call. Default 32 — enough for a
# plain instruct model's one-word answer, too small for a reasoning model
# (gpt-oss, o1/o3-style, DeepSeek-R1, Qwen3 "thinking" mode, ...), which can
# spend the whole budget on hidden reasoning tokens and return empty content.
# TRIAGE_LLM_MAX_TOKENS=32

# Used when TRIAGE_LLM_BASE_URL is unset (selects the Anthropic backend), and
# read by scripts/*_accuracy.py as an alternative to TRIAGE_LLM_API_KEY.
# ANTHROPIC_API_KEY=

# --- examples/ only — not read by triage/ itself -----------------------------

# examples/groq_agent.py
# GROQ_API_KEY=

# examples/huggingface_agent.py
# HF_TOKEN=
